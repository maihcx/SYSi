<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SYSi.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Thickness x:Key="CardControlPadding">14,16,14,16</Thickness>

    <Style TargetType="{x:Type controls:AcrylicPanel}">
        <Setter Property="Padding"
                Value="{StaticResource CardControlPadding}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BlurRadius"
                Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AcrylicPanel}">
                    <Border Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">

                        <Grid x:Name="PART_RootGrid">
                            <Rectangle Fill="{TemplateBinding BlurBrush}">
                                <Rectangle.Effect>
                                    <BlurEffect Radius="{Binding BlurRadius, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Rectangle.Effect>
                            </Rectangle>

                            <Rectangle Fill="{TemplateBinding TintBrush}" />

                            <Border x:Name="PART_BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0.7" />

                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="PART_BackgroundBorder"
                                    Property="Opacity"
                                    Value="0.6" />
                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="PART_BackgroundBorder"
                                    Property="Opacity"
                                    Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>