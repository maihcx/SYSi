<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SYSi.Controls">

    <Style TargetType="{x:Type controls:PerformanceChart}">
        <Setter Property="ChartBackground"      Value="White"/>
        <Setter Property="LineColor"            Value="#0078D4"/>
        <Setter Property="LineThickness"        Value="1.0"/>
        <Setter Property="HorizontalGridLines"  Value="9"/>
        <Setter Property="VerticalGridLines"    Value="5"/>
        <Setter Property="ShowGridLines"        Value="True"/>
        <Setter Property="ShowAxisLabels"       Value="True"/>
        <Setter Property="TimeWindowSeconds"    Value="60"/>
        <Setter Property="MaxValue"             Value="100"/>
        <Setter Property="Unit"                 Value="%"/>
        <Setter Property="MaxCapacityLabel"     Value="100%"/>
        <Setter Property="MinHeight"            Value="80"/>
        <Setter Property="MinWidth"             Value="120"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PerformanceChart}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
