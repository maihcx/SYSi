<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SYSi.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Style TargetType="{x:Type controls:PerformanceChart}">

        <!-- ✅ dùng theme brush -->
        <Setter Property="Background"
                Value="{DynamicResource ControlFillColorDefaultBrush}" />

        <Setter Property="LineBrush"
                Value="{DynamicResource SystemAccentColorPrimaryBrush}" />

        <Setter Property="GridLineBrush"
                Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />


        <Setter Property="BorderBrushEx"
                Value="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <Setter Property="FillBrush"
                Value="{DynamicResource SystemAccentColorPrimaryBrush}" />


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PerformanceChart}">

                    <Grid>

                        <!-- HEADER -->
                        <DockPanel Margin="4,2,4,0"
                                   LastChildFill="False">

                            <TextBlock Text="{TemplateBinding Title}"
                                       Foreground="{TemplateBinding AxisLabelBrush}"
                                       FontSize="12" />

                            <TextBlock DockPanel.Dock="Right"
                                       Text="{TemplateBinding MaxCapacityLabel}"
                                       Foreground="{TemplateBinding AxisLabelBrush}"
                                       FontSize="12" />
                        </DockPanel>

                        <!-- CHART -->
                        <Border Margin="0,20,0,16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrushEx}"
                                BorderThickness="1">

                            <Grid x:Name="PART_PlotArea"
                                  ClipToBounds="True">

                                <!-- GRID -->
                                <Canvas x:Name="PART_GridCanvas"
                                        IsHitTestVisible="False"
                                        Opacity="0.6" />

                                <!-- FILL -->
                                <Path x:Name="PART_Fill"
                                      IsHitTestVisible="False"
                                      StrokeThickness="0"
                                      Opacity="0.8" />

                                <!-- LINE -->
                                <Polyline x:Name="PART_Line"
                                          Stroke="{TemplateBinding LineBrush}"
                                          StrokeThickness="{TemplateBinding LineThickness}"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          IsHitTestVisible="False" />

                                <!-- CURRENT VALUE -->
                                <TextBlock Margin="6,4"
                                           Foreground="{TemplateBinding LineBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold">
                                    <Run Text="{TemplateBinding CurrentValue}" />
                                    <Run Text="{TemplateBinding Unit}" />
                                </TextBlock>

                            </Grid>
                        </Border>

                        <!-- FOOTER -->

                        <TextBlock VerticalAlignment="Bottom"
                                   HorizontalAlignment="Right"
                                   Margin="4,0,0,2"
                                   Foreground="{TemplateBinding AxisLabelBrush}"
                                   FontSize="11">

                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Path="FooterLabel"
                                             RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="Unit"
                                             RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </TextBlock.Text>

                        </TextBlock>


                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>